# ==============================================================================
# Nuclear Energy Valley 3D - Environment Configuration
# ==============================================================================

# Application Environment
APP_ENV=production
PORT=5174
HOST=127.0.0.1

# Application Branding
VITE_APP_TITLE="Nuclear Energy Valley 3D"
VITE_DEFAULT_LANG=en

# ------------------------------------------------------------------------------
# Deployment Configuration (used by scripts/deploy.sh and CI/CD)
# ------------------------------------------------------------------------------

# Deployment method: 'local' (copy on same machine) or 'ssh' (remote server via rsync/ssh)
DEPLOY_METHOD=local

# Local target directory where dist/ contents should be deployed
DEPLOY_TARGET_DIR=/var/www/nuclear-valley

# Remote server configuration (only used if DEPLOY_METHOD=ssh)
DEPLOY_REMOTE_HOST=
DEPLOY_REMOTE_USER=
DEPLOY_REMOTE_PORT=22
DEPLOY_REMOTE_DIR=/var/www/nuclear-valley
DEPLOY_SSH_KEY=

# Post-deployment health-check URL (optional, set to verify service availability)
HEALTHCHECK_URL=http://127.0.0.1:5174
